{
  "compilerOptions": {
    "target": "ES2022",

    // The package is "type": "module", so the emitted dist/ must be real ESM.
    // nodenext resolution is what makes tsc enforce Node's actual ESM rules —
    // notably that relative imports carry the emitted `.js` extension. Under
    // "bundler" resolution tsc accepts extensionless specifiers and emits them
    // verbatim, which Node then rejects at load with ERR_MODULE_NOT_FOUND.
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // Declared, not inherited: nothing here pulls Node's globals in as a
    // transitive @types dependency, and automatic @types inclusion does not
    // cover it.
    "types": ["node"],

    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
