#!/usr/bin/env bash
#
# usage: ./run command [argument ...]
#
# Commands for signalk-parquet-history-provider development.
#

set -o nounset
set -o pipefail
set -o errexit

PROJECT_ROOT=${0%/*}
if [[ $0 != $PROJECT_ROOT && $PROJECT_ROOT != "" ]]; then
  cd "$PROJECT_ROOT"
fi
readonly PROJECT_ROOT=$(pwd)

################################################################################
# Development Commands

function build {
  #@ Compile to dist/ and check the bundled extensions match
  #@ Category: Build
  npm run build
}

function test {
  #@ Build, then run the test suites
  #@ Category: Testing
  npm run build:all
}

function lint {
  #@ Check formatting and lint, without fixing
  #@ Category: Testing
  npm run ci-lint
}

function format {
  #@ Apply prettier and eslint fixes
  #@ Category: Testing
  npm run format
}

function ci {
  #@ Everything CI runs, in CI's order
  #@ Category: Testing
  if [ -f package-lock.json ]; then npm ci; else npm install; fi
  npm run ci-lint
  npm run build:all
}

################################################################################
# DuckDB extensions

function fetch-extensions {
  #@ Download the bundled DuckDB extensions (default: the published set)
  #@ Category: DuckDB
  # Compiles with tsc directly rather than `npm run build`, which also runs the
  # bundled-extension gate. That gate fails on a stale or mismatched
  # extensions/ directory -- exactly the state this command exists to repair --
  # so going through it would refuse to run the fix and name itself as the fix.
  npx tsc
  node tools/fetch-extensions.mjs "$@"
}

function check-extension {
  #@ Prove this machine reads a SQLite hot store with DuckDB, offline
  #@ Category: DuckDB
  npm run build
  node dist/duckdb/check-extension.js "$@"
}

################################################################################
# Measurement

function bench {
  #@ Run the measurement harness (run|compare|selftest)
  #@ Category: Measurement
  npm run build
  node dist/bench/cli.js "$@"
}

################################################################################
# Version

function bumpversion {
  #@ Bump VERSION and package.json together (patch|minor|major)
  #@ Category: Version
  local BUMP_TYPE=${1:-}
  if [[ -z "$BUMP_TYPE" ]]; then
    echo "Usage: ./run bumpversion [patch|minor|major]"
    exit 1
  fi

  if ! command -v bumpversion &> /dev/null; then
    echo "Error: bumpversion not installed"
    echo "Install with: uv tool install bump2version"
    exit 1
  fi

  # Both files move together or CI's check-versions fails the PR. That check is
  # the point: npm publishes package.json's version while the release workflow
  # reads VERSION, so a drift publishes one number under another's release.
  echo "Bumping $BUMP_TYPE version..."
  command bumpversion "$BUMP_TYPE"
  echo "Version bumped and committed successfully"
  echo "New version: $(cat VERSION)"
  echo "Push with: git push"
}

################################################################################
# Help System

function help {
  #@ Show this help message
  #@ Category: Core
  echo "signalk-parquet-history-provider - Development Commands"
  echo "======================================================"
  echo ""
  echo "Available commands:"
  echo ""

  # Extract function definitions and their help comments
  awk '/^function / {
    fname = $2
    sub(/[({].*/, "", fname)
    getline
    if ($0 ~ /#@/) {
      desc = $0
      sub(/.*#@ /, "", desc)
      sub(/ *$/, "", desc)
      getline
      if ($0 ~ /#@ Category:/) {
        cat = $0
        sub(/.*Category: /, "", cat)
        sub(/ *$/, "", cat)
        if (!seen[cat]++) categories[++cat_count] = cat
        commands[cat, ++cmd_count[cat]] = fname
        descriptions[cat, cmd_count[cat]] = desc
      }
    }
  }
  END {
    for (i = 1; i <= cat_count; i++) {
      cat = categories[i]
      print "\n" cat ":"
      for (j = 1; j <= cmd_count[cat]; j++) {
        printf "  %-25s %s\n", commands[cat, j], descriptions[cat, j]
      }
    }
  }' "$0"

  echo ""
  echo "Usage: ./run <command> [arguments...]"
  echo ""
}

################################################################################
# Commands end.

TIMEFORMAT=$'\nTask completed in %3lR'
time "${@:-help}"
